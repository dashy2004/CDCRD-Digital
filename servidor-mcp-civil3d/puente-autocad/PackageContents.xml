<?xml version="1.0" encoding="utf-8"?>
<!-- AutoCAD 2027 base only. Civil 3D uses its separate bundle. -->
<ApplicationPackage
  SchemaVersion="1.0"
  AppVersion="0.5.19"
  Author="CDCRD-Digital"
  Name="CDCRD Puente MCP AutoCAD"
  Description="Expone el dibujo activo de AutoCAD a un servidor MCP local"
  ProductCode="{7F1C2A64-5D3B-4E21-9C58-CD3CDA000001}"
  UpgradeCode="{7F1C2A64-5D3B-4E21-9C58-CD3CDA000002}">

  <CompanyDetails Name="CDCRD-Digital" Url="https://github.com/dashy2004/CDCRD-Digital" />

  <Components>
    <!-- R26.0 = serie de AutoCAD 2027 -->
    <RuntimeRequirements SupportPath="./Contents" Platform="AutoCAD" SeriesMin="R26.0" SeriesMax="R26.0" OS="Win64" />
    <ComponentEntry
      AppName="CdcrdAutoCadBridge"
      AppDescription="Puente JSON-RPC en 127.0.0.1 para el servidor MCP de CDCRD"
      AppType=".NET"
      ModuleName="./Contents/Cdcrd.AutoCadBridge.dll"
      LoadOnAutoCADStartup="True"
      LoadOnRequest="True">
      <Commands GroupName="CDCRD">
        <Command Global="CDCRDMCP" Local="CDCRDMCP" />
        <Command Global="CDCRDMCPSTOP" Local="CDCRDMCPSTOP" />
        <Command Global="CDCRDMCPINFO" Local="CDCRDMCPINFO" />
      </Commands>
    </ComponentEntry>
  </Components>

  <DisplayInAppManager>false</DisplayInAppManager>
</ApplicationPackage>
