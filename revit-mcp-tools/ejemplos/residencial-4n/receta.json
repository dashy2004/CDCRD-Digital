{
  "nombre": "Residencial 4N - edificio residencial de 4 niveles y 8 apartamentos (ejemplo generico)",
  "descripcion": "Secuencia de tools de revit-mcp-tools que modela desde cero la estructura de un edificio de 20 x 12 m (ejes A-E cada 5 m, 1-4 cada 4 m), 4 niveles de 3.00 m sobre una cimentacion a -1.50, y produce plantas, laminas, tablas, PDF, IFC y proyecto.json. Correr sobre un proyecto NUEVO (plantilla Structural) o sobre una copia sacrificable. Cada paso tiene dry_run=true; correr_receta.py lo pone en false con --real.",
  "requisitos": ["Revit 2027 con pyRevit Routes y mcp-server-for-revit-python cargado", "documento activo = proyecto nuevo o copia", "biblioteca English-Imperial de Revit 2027 instalada (familias de hormigon de Autodesk)"],
  "ejes": ["A", "B", "C", "D", "E", "1", "2", "3", "4"],
  "pasos": [
    {"id": "01", "tool": "estado", "params": {}, "nota": "leer antes de escribir: niveles, conteos, vista activa"},
    {"id": "02", "tool": "niveles_ejes", "params": {
      "levels": [
        {"name": "CIMENTACION", "elevation_mm": -1500},
        {"name": "N1", "elevation_mm": 0},
        {"name": "N2", "elevation_mm": 3000},
        {"name": "N3", "elevation_mm": 6000},
        {"name": "N4", "elevation_mm": 9000},
        {"name": "TECHO", "elevation_mm": 12000}
      ],
      "rejilla": {
        "verticales": {"nombres": ["A", "B", "C", "D", "E"], "origen_mm": 0, "separaciones_mm": [5000, 5000, 5000, 5000]},
        "horizontales": {"nombres": ["1", "2", "3", "4"], "origen_mm": 0, "separaciones_mm": [4000, 4000, 4000]},
        "margen_mm": 1500
      },
      "dry_run": true}},
    {"id": "03", "tool": "vistas_planta", "params": {"levels": ["CIMENTACION", "N1", "N2", "N3", "N4", "TECHO"], "kind": "estructural", "prefix": "EST ", "scale": 100, "cut_mm": 1500, "crop": true, "dry_run": true},
     "nota": "una planta estructural por nivel, sin underlay. crop=true recorta a la caja del modelo: en un proyecto nuevo todavia no hay elementos, asi que el recorte se aplica al final (paso 21b); aqui solo define nombre, escala y corte"},
    {"id": "04", "tool": "familias_cargar", "params": {"familias": [
        "Structural Columns\\Concrete\\Concrete-Rectangular-Column.rfa",
        "Structural Framing\\Concrete\\Concrete-Rectangular Beam.rfa",
        "Structural Foundations\\Footing-Rectangular.rfa"], "dry_run": true}},
    {"id": "05", "tool": "tipos", "params": {"tipos": [
        {"categoria": "columna", "nombre": "C40x40", "base": "Concrete-Rectangular-Column: 18 x 24", "params_mm": {"b": 400, "h": 400}},
        {"categoria": "viga", "nombre": "V30x50", "base": "Concrete-Rectangular Beam: 12 x 24", "params_mm": {"b": 300, "h": 500}},
        {"categoria": "zapata", "nombre": "Z120x120x40", "base": "Footing-Rectangular: 72\" x 48\" x 18\"", "params_mm": {"Width": 1200, "Length": 1200, "Foundation Thickness": 400}},
        {"categoria": "losa", "nombre": "LOSA MACIZA 15", "espesor_mm": 150},
        {"categoria": "muro", "nombre": "MURO BLOQUE 15", "espesor_mm": 150}], "dry_run": true},
     "nota": "si el tipo base no existe con ese nombre, la respuesta en dry_run lista los disponibles"},
    {"id": "06", "tool": "columnas", "params": {"tipo": "C40x40", "nivel_base": "CIMENTACION", "nivel_tope": "N2", "posiciones": "todas", "ejes": ["A","B","C","D","E","1","2","3","4"], "dry_run": true}},
    {"id": "07", "tool": "columnas", "params": {"tipo": "C40x40", "nivel_base": "N2", "nivel_tope": "N3", "posiciones": "todas", "ejes": ["A","B","C","D","E","1","2","3","4"], "dry_run": true}},
    {"id": "08", "tool": "columnas", "params": {"tipo": "C40x40", "nivel_base": "N3", "nivel_tope": "N4", "posiciones": "todas", "ejes": ["A","B","C","D","E","1","2","3","4"], "dry_run": true}},
    {"id": "09", "tool": "columnas", "params": {"tipo": "C40x40", "nivel_base": "N4", "nivel_tope": "TECHO", "posiciones": "todas", "ejes": ["A","B","C","D","E","1","2","3","4"], "dry_run": true}},
    {"id": "10", "tool": "zapatas", "params": {"tipo": "Z120x120x40", "nivel": "CIMENTACION", "columnas": "marker:AGENTE:COL", "dry_run": true},
     "nota": "solo las columnas del nivel base mas bajo reciben zapata; gap_mm debe ser 0"},
    {"id": "11", "tool": "vigas_crear", "params": {"tipo": "V30x50", "nivel": "N2", "tramos": "por_ejes", "ejes": ["A","B","C","D","E","1","2","3","4"], "dry_run": true}},
    {"id": "12", "tool": "vigas_crear", "params": {"tipo": "V30x50", "nivel": "N3", "tramos": "por_ejes", "ejes": ["A","B","C","D","E","1","2","3","4"], "dry_run": true}},
    {"id": "13", "tool": "vigas_crear", "params": {"tipo": "V30x50", "nivel": "N4", "tramos": "por_ejes", "ejes": ["A","B","C","D","E","1","2","3","4"], "dry_run": true}},
    {"id": "14", "tool": "vigas_crear", "params": {"tipo": "V30x50", "nivel": "TECHO", "tramos": "por_ejes", "ejes": ["A","B","C","D","E","1","2","3","4"], "dry_run": true}},
    {"id": "15", "tool": "losas_crear", "params": {"tipo": "LOSA MACIZA 15", "nivel": "N2", "modo": "envolvente_ejes", "dry_run": true}},
    {"id": "16", "tool": "losas_crear", "params": {"tipo": "LOSA MACIZA 15", "nivel": "N3", "modo": "envolvente_ejes", "dry_run": true}},
    {"id": "17", "tool": "losas_crear", "params": {"tipo": "LOSA MACIZA 15", "nivel": "N4", "modo": "envolvente_ejes", "dry_run": true}},
    {"id": "18", "tool": "losas_crear", "params": {"tipo": "LOSA MACIZA 15", "nivel": "TECHO", "modo": "envolvente_ejes", "dry_run": true}},
    {"id": "19", "tool": "muros_crear", "params": {"tipo": "MURO BLOQUE 15", "nivel_base": "N1", "nivel_tope": "N2", "tramos": "por_ejes", "ejes": ["A", "E", "1", "4"], "estructural": false, "dry_run": true},
     "nota": "cerramiento perimetral del primer nivel; la division interior de los 2 apartamentos por nivel va con lineas_mm. Con estructural=false los muros NO aparecen en vistas de disciplina Structural (plantas EST y 3D ESTRUCTURA): es comportamiento de Revit, no un fallo de la tool; verlos en una vista de disciplina Coordination o crearlos con estructural=true"},
    {"id": "20", "tool": "muros_crear", "params": {"tipo": "MURO BLOQUE 15", "nivel_base": "N1", "nivel_tope": "N2", "lineas_mm": [[[10000, 0], [10000, 12000]]], "estructural": false, "dry_run": true},
     "nota": "muro divisorio entre apartamentos (eje C)"},
    {"id": "21", "tool": "vista_3d", "params": {"name": "3D ESTRUCTURA", "marker": "AGENTE:", "replace": true}},
    {"id": "21b", "tool": "vistas_planta", "params": {"levels": ["CIMENTACION", "N1", "N2", "N3", "N4", "TECHO"], "kind": "estructural", "prefix": "EST ", "scale": 100, "cut_mm": 1500, "crop": true, "replace": true, "dry_run": true},
     "nota": "rehace las plantas ya con el modelo presente para que el recorte abrace el edificio (replace=true)"},
    {"id": "22", "tool": "ver_vista", "params": {"views": ["3D ESTRUCTURA", "EST N2"], "prefix": "verificacion", "pixel_width": 1600},
     "nota": "MIRAR los PNG antes de seguir (ADR-0005). Lo que no se ve en la imagen no existe."},
    {"id": "23", "tool": "auditar", "params": {"marker": "AGENTE:"}},
    {"id": "24", "tool": "tablas", "params": {"tablas": [
        {"name": "TABLA DE COLUMNAS", "category": "columnas", "fields": ["Type", "Base Level", "Top Level", "Count"], "sort": "Base Level"},
        {"name": "TABLA DE VIGAS", "category": "vigas", "fields": ["Type", "Reference Level", "Cut Length", "Count"], "sort": "Reference Level"},
        {"name": "TABLA DE LOSAS", "category": "losas", "fields": ["Type", "Level", "Area", "Count"], "sort": "Level"},
        {"name": "TABLA DE ZAPATAS", "category": "zapatas", "fields": ["Type", "Level", "Count"], "sort": "Type"}], "dry_run": true},
     "nota": "en dry_run la respuesta trae los campos disponibles por categoria: ajustar 'fields' si la instalacion esta en otro idioma"},
    {"id": "25", "tool": "laminas", "params": {"sheets": [
        {"number": "E-01", "name": "PLANTA ESTRUCTURAL N2", "views": ["EST N2", "TABLA DE COLUMNAS", "TABLA DE VIGAS"]},
        {"number": "E-02", "name": "PLANTA ESTRUCTURAL N3", "views": ["EST N3"]},
        {"number": "E-03", "name": "PLANTA ESTRUCTURAL N4", "views": ["EST N4"]},
        {"number": "E-04", "name": "PLANTA ESTRUCTURAL TECHO", "views": ["EST TECHO", "TABLA DE LOSAS"]},
        {"number": "E-05", "name": "CIMENTACION", "views": ["EST CIMENTACION", "TABLA DE ZAPATAS"]}], "dry_run": true}},
    {"id": "26", "tool": "ver_vista", "params": {"views": ["E-01", "E-05"], "prefix": "lamina", "pixel_width": 2400},
     "nota": "mirar las laminas: desbordes, tablas encima del cajetin, escala ilegible"},
    {"id": "27", "tool": "exportar_pdf", "params": {"folder": "<carpeta de salida>", "file_name": "residencial-4n-estructura"}},
    {"id": "28", "tool": "exportar_ifc", "params": {"folder": "<carpeta de salida>", "file_name": "residencial-4n", "version": "IFC4"}},
    {"id": "29", "tool": "exportar_proyecto", "params": {"path": "<carpeta de salida>\\proyecto.json", "marker": "AGENTE:", "proyecto": "Residencial 4N"},
     "nota": "el bloque 'etabs' del JSON trae los argumentos para fea: set_stories, define_concrete_material, define_rect_section, create_objects_by_coordinates"},
    {"id": "30", "tool": "guardar_modelo", "params": {}}
  ],
  "limpieza": {"tool": "borrar_por_marca", "params": {"marker": "AGENTE:", "ejes_nombres": ["A","B","C","D","E","1","2","3","4"], "niveles_nombres": ["CIMENTACION","N1","N2","N3","N4","TECHO"], "dry_run": true},
               "nota": "borra todo lo creado por la receta; los niveles al final porque arrastran lo que hospedan"}
}
